{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lynterminal",
  "version": "1.6.5",
  "identifier": "com.lynterminal.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LynTerminal — Modern Business OS",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#F5F5F7"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' tauri:; style-src 'self' 'unsafe-inline' tauri:; img-src 'self' data: blob: tauri:; font-src 'self' data: tauri:; connect-src 'self' ipc: tauri: http://ipc.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm"],
    "publisher": "Wintershogun Tech Studio",
    "homepage": "https://lynterminal.wintershogun.tech",
    "shortDescription": "Offline Business OS & Indian GST POS Terminal",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
