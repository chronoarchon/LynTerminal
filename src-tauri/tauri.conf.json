{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lynterminal",
  "version": "1.5.1",
  "identifier": "com.lynterminal.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LynTerminal — Modern Business OS",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 540,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' tauri:; style-src 'self' 'unsafe-inline' tauri:; img-src 'self' data: blob: tauri:; font-src 'self' data: tauri:; connect-src 'self' ipc: tauri: http://ipc.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
