# Maintainer: chronoarchon <chronoarchon@users.noreply.github.com>
pkgname=lynterminal
pkgver=1.3.1v
pkgrel=1
pkgdesc="LynTerminal v1.3.1v — Modern Offline-First Business Management OS & Point of Sale"
arch=('x86_64')
url="https://github.com/chronoarchon/LynTerminal"
license=('Proprietary')
depends=('webkit2gtk-4.1' 'gtk3' 'cairo' 'gdk-pixbuf2' 'glib2' 'pango' 'openssl' 'hicolor-icon-theme')
provides=('lynterminal')
conflicts=('lynterminal-bin' 'lyndesk' 'lyndesk-bin')
source=(
    "lynterminal"
    "lynterminal.desktop"
    "16x16.png"
    "32x32.png"
    "48x48.png"
    "64x64.png"
    "128x128.png"
    "256x256.png"
    "512x512.png"
    "lynterminal.svg"
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    # 1. Install binary executable
    install -Dm755 "${srcdir}/lynterminal" "${pkgdir}/usr/bin/lynterminal"

    # 2. Install desktop shortcut
    install -Dm644 "${srcdir}/lynterminal.desktop" "${pkgdir}/usr/share/applications/lynterminal.desktop"

    # 3. Install application icons across all hicolor resolutions
    for size in 16 32 48 64 128 256 512; do
        install -Dm644 "${srcdir}/${size}x${size}.png" "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/lynterminal.png"
    done
    install -Dm644 "${srcdir}/lynterminal.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/lynterminal.svg"
    install -Dm644 "${srcdir}/lynterminal.svg" "${pkgdir}/usr/share/pixmaps/lynterminal.svg"
    install -Dm644 "${srcdir}/256x256.png" "${pkgdir}/usr/share/pixmaps/lynterminal.png"
}
